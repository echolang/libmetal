/**
 * Compiled Metal shaders: `id<MTLLibrary>`, one function from it, and the
 * compile options that built it.
 */

namespace mtl;

public struct CompileOptions
{

    /**
     * One bool for both Metal knobs. Apple split `fastMathEnabled` into `mathMode` and
     * `mathFloatingPointFunctions` on Metal 15. We still ship one switch because they mean the
     * same thing: precise math, or the fast cheat. Default is true, matching Metal. Fast `tanh`
     * is NaN from 45 up. That is a different function, not a rounding error.
     */
    public bool $fastMathEnabled = true;

    // .default is 0. the C shim turns that into MSL 2.1. alloc-init on macOS 15 is not that
    public LanguageVersion $languageVersion = .default;

    internal const function abi() : AbiCompileOpts
    {
        int32 $fast = 0;

        if ($this->fastMathEnabled) {
            $fast = 1;
        }

        return AbiCompileOpts($fast, $this->languageVersion->value());
    }
}

#[atomic]
public class Library
{
    private ptr<mtl_library> $id;

    private constructor(ptr<mtl_library> $id)
    {
        $this->id = $id;
    }

    destructor()
    {
        if ($this->id != null) {
            cRelease(asObj($this->id));
            $this->id:$ = null;
        }
    }

    internal const function raw() : ptr<mtl_library>
    {
        return live($this->id, 'Library handle is null');
    }

    internal static function adopt(ptr<mtl_library> $id) : Library?
    {
        if ($id == null) {
            return null;
        }

        return Library($id);
    }

    public function newFunction(const string& $name) : Function?
    {
        return Function::adopt(cLibraryNewFunction($this->raw(), $name->cstr()));
    }
}

#[atomic]
public class Function
{
    private ptr<mtl_function> $id;

    private constructor(ptr<mtl_function> $id)
    {
        $this->id = $id;
    }

    destructor()
    {
        if ($this->id != null) {
            cRelease(asObj($this->id));
            $this->id:$ = null;
        }
    }

    internal const function raw() : ptr<mtl_function>
    {
        return live($this->id, 'Function handle is null');
    }

    internal static function adopt(ptr<mtl_function> $id) : Function?
    {
        if ($id == null) {
            return null;
        }

        return Function($id);
    }
}
