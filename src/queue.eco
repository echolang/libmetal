/**
 * `id<MTLCommandQueue>`.
 */

namespace mtl;

#[atomic]
public class CommandQueue
{
    private ptr<mtl_queue> $id;

    private constructor(ptr<mtl_queue> $id)
    {
        $this->id = $id;
    }

    destructor()
    {
        if ($this->id != null) {
            cRelease(asObj($this->id));
            $this->id:$ = null;
        }
    }

    internal const function raw() : ptr<mtl_queue>
    {
        return live($this->id, 'CommandQueue handle is null');
    }

    internal static function adopt(ptr<mtl_queue> $id) : CommandQueue?
    {
        if ($id == null) {
            return null;
        }

        return CommandQueue($id);
    }

    public function commandBuffer() : CommandBuffer?
    {
        return CommandBuffer::adopt(cQueueCommandBuffer($this->raw()));
    }
}
