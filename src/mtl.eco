/**
 * libmetal. Metal GPU bindings. Apple platforms only.
 *
 * Objects are Echo classes over retained Metal ids. `available` is whether
 * `MTLCreateSystemDefaultDevice` produced one.
 */

namespace mtl;

internal const usize ERR_CAP = 512;

internal function live<T>(ptr<T> $p, string $what) : ptr<T>
{
    if ($p == null) {
        die("mtl: {$what}");
    }

    return $p;
}

internal function asObj<T>(ptr<T> $p) : ptr<uint8>
{
    return $p:$ as ptr<uint8>;
}

internal function takeCString(ptr<uint8> $buf) : string
{
    if ($buf:$ == null) {
        return '';
    }

    return str::from(ptr<const uint8>($buf:$));
}

internal function errSpare(string& $err) : ptr<uint8>
{
    $err->reserve(ERR_CAP);
    ptr<uint8> $p = $err->spare();

    if ($p:$ != null) {
        $p:$[0] = 0;
    }

    return $err->spare();
}

/**
 * True when this process has a Metal device.
 */
public function available() : bool
{
    ptr<mtl_device> $p = cDeviceDefault();

    if ($p == null) {
        return false;
    }

    cRelease(asObj($p));
    return true;
}
