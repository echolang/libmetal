/**
 * Metal enumerations, Apple's numeric values.
 *
 * Exclusive choices are backed enums. Bitmasks (texture usage) are uint32
 * constants so they can be combined.
 */

namespace mtl;

public enum PixelFormat : uint32
{
    case invalid = 0;
    case a8Unorm = 1;
    case r8Unorm = 10;
    case r16Float = 25;
    case r32Uint = 53;
    case r32Float = 55;
    case rg16Float = 65;
    case rgba8Unorm = 70;
    case rgba8Unorm_srgb = 71;
    case bgra8Unorm = 80;
    case bgra8Unorm_srgb = 81;
    case rgba16Float = 115;
    case rgba32Float = 125;
    case bc1Rgba = 130;
    case bc3Rgba = 134;
    case bc7RgbaUnorm = 152;
    case bc7RgbaUnorm_srgb = 153;
    case astc4x4Srgb = 186;
    case astc4x4Ldr = 204;
    case depth32Float = 252;
    case stencil8 = 253;
    case depth32Float_stencil8 = 260;
}

public enum StorageMode : uint32
{
    case shared = 0;
    case managed = 1;
    case devicePrivate = 2;
    case memoryless = 3;
}

public enum ResourceOptions : uint32
{
    case shared = 0;
    case managed = 16;
    case devicePrivate = 32;
    case memoryless = 48;
}

public enum CPUCacheMode : uint32
{
    case defaultCache = 0;
    case writeCombined = 1;
}

public enum HazardTrackingMode : uint32
{
    case default = 0;
    case untracked = 1;
    case tracked = 2;
}

public const uint32 TEXTURE_USAGE_SHADER_READ = 1;
public const uint32 TEXTURE_USAGE_SHADER_WRITE = 2;
public const uint32 TEXTURE_USAGE_RENDER_TARGET = 4;
public const uint32 TEXTURE_USAGE_PIXEL_FORMAT_VIEW = 16;

public enum TextureType : uint32
{
    case type1D = 0;
    case type1DArray = 1;
    case type2D = 2;
    case type2DArray = 3;
    case type2DMultisample = 4;
    case typeCube = 5;
    case type3D = 7;
}

public enum LoadAction : uint32
{
    case dontCare = 0;
    case load = 1;
    case clear = 2;
}

public enum StoreAction : uint32
{
    case dontCare = 0;
    case store = 1;
    case multisampleResolve = 2;
}

public enum PrimitiveType : uint32
{
    case point = 0;
    case line = 1;
    case lineStrip = 2;
    case triangle = 3;
    case triangleStrip = 4;
}

public enum IndexType : uint32
{
    case uint16 = 0;
    case uint32 = 1;
}

public enum CullMode : uint32
{
    case none = 0;
    case front = 1;
    case back = 2;
}

public enum TriangleFillMode : uint32
{
    case fill = 0;
    case lines = 1;
}

public enum Winding : uint32
{
    case clockwise = 0;
    case counterClockwise = 1;
}

public enum BlendFactor : uint32
{
    case zero = 0;
    case one = 1;
    case sourceColor = 2;
    case oneMinusSourceColor = 3;
    case sourceAlpha = 4;
    case oneMinusSourceAlpha = 5;
    case destinationColor = 6;
    case oneMinusDestinationColor = 7;
    case destinationAlpha = 8;
    case oneMinusDestinationAlpha = 9;
}

public enum BlendOperation : uint32
{
    case add = 0;
    case subtract = 1;
    case reverseSubtract = 2;
    case min = 3;
    case max = 4;
}

public const uint32 COLOR_WRITE_MASK_RED = 8;
public const uint32 COLOR_WRITE_MASK_GREEN = 4;
public const uint32 COLOR_WRITE_MASK_BLUE = 2;
public const uint32 COLOR_WRITE_MASK_ALPHA = 1;
public const uint32 COLOR_WRITE_MASK_ALL = 15;

public enum CompareFunction : uint32
{
    case never = 0;
    case less = 1;
    case equal = 2;
    case lessEqual = 3;
    case greater = 4;
    case notEqual = 5;
    case greaterEqual = 6;
    case always = 7;
}

public enum StencilOperation : uint32
{
    case keep = 0;
    case zero = 1;
    case replace = 2;
    case incrementClamp = 3;
    case decrementClamp = 4;
    case invert = 5;
    case incrementWrap = 6;
    case decrementWrap = 7;
}

public enum SamplerMinMagFilter : uint32
{
    case nearest = 0;
    case linear = 1;
}

public enum SamplerMipFilter : uint32
{
    case notMipmapped = 0;
    case nearest = 1;
    case linear = 2;
}

public enum SamplerAddressMode : uint32
{
    case clampToEdge = 0;
    case repeat = 2;
    case mirrorRepeat = 3;
    case clampToZero = 4;
}

public enum VertexFormat : uint32
{
    case invalid = 0;
    case uchar2 = 1;
    case uchar3 = 2;
    case uchar4 = 3;
    case float = 28;
    case float2 = 29;
    case float3 = 30;
    case float4 = 31;
    case int = 32;
    case uint = 36;
}

public enum VertexStepFunction : uint32
{
    case constant = 0;
    case perVertex = 1;
    case perInstance = 2;
    case perPatch = 3;
    case perPatchControlPoint = 4;
}

public enum TessellationPartitionMode : uint32
{
    case pow2 = 0;
    case integer = 1;
    case fractionalOdd = 2;
    case fractionalEven = 3;
}

public enum TessellationFactorFormat : uint32
{
    case half = 0;
}

public enum TessellationFactorStepFunction : uint32
{
    case constant = 0;
    case perPatch = 1;
    case perInstance = 2;
    case perPatchAndPerInstance = 3;
}

public enum TessellationControlPointIndexType : uint32
{
    case none = 0;
    case uint16 = 1;
    case uint32 = 2;
}

public enum LanguageVersion : uint32
{
    // c shim maps 0 to msl 2.1
    case default = 0;
    case v1_1 = 65537;
    case v1_2 = 65538;
    case v2_0 = 131072;
    case v2_1 = 131073;
    case v2_2 = 131074;
    case v2_3 = 131075;
    case v2_4 = 131076;
    case v3_0 = 196608;
    case v3_1 = 196609;
    case v3_2 = 196610;
}

/**
 * Where a device can sample GPU counters. Apple silicon answers stage boundary only.
 */
public enum CounterSamplingPoint : uint32
{
    case atStageBoundary = 0;
    case atDrawBoundary = 1;
    case atDispatchBoundary = 2;
    case atTileDispatchBoundary = 3;
    case atBlitBoundary = 4;
}

public enum CommandBufferStatus : uint32
{
    case notEnqueued = 0;
    case enqueued = 1;
    case committed = 2;
    case scheduled = 3;
    case completed = 4;
    case error = 5;
}
