/**
 * Pass descriptors and the ABI packers that turn them into C structs.
 * Render, blit, and compute passes can attach a counter sample buffer.
 */

namespace mtl;

public struct ColorAttachment
{
    public Texture $texture;
    public LoadAction $loadAction = .clear;
    public StoreAction $storeAction = .store;
    public ClearColor $clearColor;
    /** mip level to render into */
    public uint32 $level = 0;
    /** array slice; a cube face is a slice */
    public uint32 $slice = 0;
}

/**
 * GPU timestamps at the four render stage boundaries. Indices default to
 * `COUNTER_DONT_SAMPLE`, Metal's own skip value. A null `$sample` on the
 * pass descriptor means do not attach a sample buffer at all.
 */
public struct RenderPassSample
{
    public CounterSampleBuffer $buffer;
    public uint64 $vertexStart = COUNTER_DONT_SAMPLE;
    public uint64 $vertexEnd = COUNTER_DONT_SAMPLE;
    public uint64 $fragmentStart = COUNTER_DONT_SAMPLE;
    public uint64 $fragmentEnd = COUNTER_DONT_SAMPLE;
}

/**
 * GPU timestamps at blit encoder start and end. Indices default to
 * `COUNTER_DONT_SAMPLE`.
 */
public struct BlitPassSample
{
    public CounterSampleBuffer $buffer;
    public uint64 $start = COUNTER_DONT_SAMPLE;
    public uint64 $end = COUNTER_DONT_SAMPLE;
}

/**
 * GPU timestamps at compute encoder start and end. Same layout as blit.
 */
public struct ComputePassSample
{
    public CounterSampleBuffer $buffer;
    public uint64 $start = COUNTER_DONT_SAMPLE;
    public uint64 $end = COUNTER_DONT_SAMPLE;
}

public struct RenderPassDescriptor
{
    public array<ColorAttachment> $colorAttachments = array<ColorAttachment>();
    public Texture? $depthTexture = null;
    public LoadAction $depthLoadAction = .clear;
    public StoreAction $depthStoreAction = .dontCare;
    public float32 $depthClear = 1.0f;
    /** mip level to render into */
    public uint32 $depthLevel = 0;
    /** array slice; a cube face is a slice */
    public uint32 $depthSlice = 0;
    public RenderPassSample? $sample = null;

    internal const function abi() : AbiRenderPass
    {
        return packRenderPass($this);
    }
}

public struct BlitPassDescriptor
{
    public BlitPassSample? $sample = null;

    internal const function abi() : AbiBlitPass
    {
        return AbiBlitPass(packBlitSample($this->sample));
    }
}

public struct ComputePassDescriptor
{
    public ComputePassSample? $sample = null;

    internal const function abi() : AbiComputePass
    {
        return AbiComputePass(packComputeSample($this->sample));
    }
}

internal function emptySample() : AbiSampleAttach
{
    return AbiSampleAttach(null, 0, 0, 0, 0);
}

internal function packRenderSample(RenderPassSample? $s) : AbiSampleAttach
{
    RenderPassSample $x = guard $s else {
        return emptySample();
    }
    return AbiSampleAttach(
        $x->buffer->raw(),
        $x->vertexStart,
        $x->vertexEnd,
        $x->fragmentStart,
        $x->fragmentEnd
    );
}

internal function packBoundarySample(CounterSampleBuffer $buffer, uint64 $start, uint64 $end) : AbiSampleAttach
{
    return AbiSampleAttach(
        $buffer->raw(),
        $start,
        $end,
        COUNTER_DONT_SAMPLE,
        COUNTER_DONT_SAMPLE
    );
}

internal function packBlitSample(BlitPassSample? $s) : AbiSampleAttach
{
    BlitPassSample $x = guard $s else {
        return emptySample();
    }
    return packBoundarySample($x->buffer, $x->start, $x->end);
}

internal function packComputeSample(ComputePassSample? $s) : AbiSampleAttach
{
    ComputePassSample $x = guard $s else {
        return emptySample();
    }
    return packBoundarySample($x->buffer, $x->start, $x->end);
}

internal function textureRaw(Texture? $t) : ptr<mtl_texture>
{
    Texture $x = guard $t else {
        return null;
    }
    return $x->raw();
}

internal function packColorAttach(const array<ColorAttachment>& $a, usize $i) : AbiColorAttach
{
    if ($i >= $a->count()) {
        return AbiColorAttach(null, 0, 0, 0, 0, AbiClearColor(0.0, 0.0, 0.0, 1.0));
    }

    $c = $a[$i];
    return AbiColorAttach(
        $c->texture->raw(),
        $c->loadAction->value(),
        $c->storeAction->value(),
        $c->level,
        $c->slice,
        $c->clearColor->abi()
    );
}

internal function packRenderPass(const RenderPassDescriptor& $d) : AbiRenderPass
{
    usize $n = $d->colorAttachments->count();

    if ($n > 8) {
        $n = 8;
    }

    return AbiRenderPass(
        packColorAttach($d->colorAttachments, 0),
        packColorAttach($d->colorAttachments, 1),
        packColorAttach($d->colorAttachments, 2),
        packColorAttach($d->colorAttachments, 3),
        packColorAttach($d->colorAttachments, 4),
        packColorAttach($d->colorAttachments, 5),
        packColorAttach($d->colorAttachments, 6),
        packColorAttach($d->colorAttachments, 7),
        $n as uint32,
        0,
        textureRaw($d->depthTexture),
        $d->depthLoadAction->value(),
        $d->depthStoreAction->value(),
        $d->depthClear,
        $d->depthLevel,
        $d->depthSlice,
        0,
        packRenderSample($d->sample)
    );
}
