        }
    }

    internal const function raw() : ptr<mtl_compute_pipeline>
    {
        return live($this->id, 'ComputePipelineState handle is null');
    }

    internal static function adopt(ptr<mtl_compute_pipeline> $id) : ComputePipelineState?
    {
        if ($id == null) {
            return null;
        }

        return ComputePipelineState($id);
    }
}

#[atomic]
public class DepthStencilState
{
    private ptr<mtl_depth_stencil> $id;

    private constructor(ptr<mtl_depth_stencil> $id)
    {
        $this->id = $id;
    }

    destructor()
    {
        if ($this->id != null) {
            cRelease(asObj($this->id));
            $this->id:$ = null;
        }
    }

    internal const function raw() : ptr<mtl_depth_stencil>
    {
        return live($this->id, 'DepthStencilState handle is null');
    }

    internal static function adopt(ptr<mtl_depth_stencil> $id) : DepthStencilState?
    {
        if ($id == null) {
            return null;
        }

        return DepthStencilState($id);
    }
}
