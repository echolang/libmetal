/**
 * Command buffers and the three encoders. Encoder destructors call
 * `endEncoding` if you forgot.
 */

namespace mtl;

public class CommandBuffer
{
    private ptr<mtl_command_buffer> $id;

    private constructor(ptr<mtl_command_buffer> $id)
    {
        $this->id = $id;
    }

    destructor()
    {
        if ($this->id != null) {
            cRelease(asObj($this->id));
            $this->id:$ = null;
        }
    }

    internal const function raw() : ptr<mtl_command_buffer>
    {
        return live($this->id, 'CommandBuffer handle is null');
    }

    internal static function adopt(ptr<mtl_command_buffer> $id) : CommandBuffer?
    {
        if ($id == null) {
            return null;
        }

        return CommandBuffer($id);
    }

    public function commit() : void
    {
        cCommandCommit($this->raw());
    }

    public function waitUntilCompleted() : void
    {
        cCommandWait($this->raw());
    }

    /**
     * GPU timeline seconds. 0 until the buffer has completed.
     * Occupancy including driver scheduling and a present encoded on this buffer.
     */
    public const function gpuStart() : float64
    {
        return cCommandGpuStart($this->raw());
    }

    public const function gpuEnd() : float64
    {
        return cCommandGpuEnd($this->raw());
    }

    /**
     * First / last kernel on this buffer, seconds. 0 until completed.
     * Occupancy of this buffer's GPU work; excludes present wait.
     */
    public const function kernelStart() : float64
    {
        return cCommandKernelStart($this->raw());
    }

    public const function kernelEnd() : float64
    {
        return cCommandKernelEnd($this->raw());
    }

    public function present(Drawable $drawable) : void
    {
        cCommandPresent($this->raw(), $drawable->raw());
    }

    public function present(Drawable $drawable, after: float64 $seconds) : void
    {
        cCommandPresentAfter($this->raw(), $drawable->raw(), $seconds);
    }

    public function encodeSignalEvent(SharedEvent $event, uint64 $value) : void
    {
        cCommandSignalEvent($this->raw(), $event->raw(), $value);
    }

    public function encodeWaitForEvent(SharedEvent $event, uint64 $value) : void
    {
        cCommandWaitEvent($this->raw(), $event->raw(), $value);
    }

    public function renderCommandEncoder(const RenderPassDescriptor& $pass) : RenderCommandEncoder?
    {
        $abi = $pass->abi();
        return RenderCommandEncoder::adopt(cCommandRender($this->raw(), &$abi));
    }

    public function blitCommandEncoder() : BlitCommandEncoder?
    {
        return BlitCommandEncoder::adopt(cCommandBlit($this->raw(), null));
    }

    /**
     * Blit encoder from a descriptor, for timestamp samples around the copy.
     */
    public function blitCommandEncoder(const BlitPassDescriptor& $pass) : BlitCommandEncoder?
    {
        $abi = $pass->abi();
        return BlitCommandEncoder::adopt(cCommandBlit($this->raw(), &$abi));
    }

    /**
     * Where the buffer is in its life. `completed` is when GPU times and counters are readable.
     */
    public const function status() : CommandBufferStatus
    {
        CommandBufferStatus $s = guard CommandBufferStatus::from(cCommandStatus($this->raw())) else {
            return .error;
        }
        return $s;
    }

    public function setLabel(const string& $label) : void
    {
        cCommandSetLabel($this->raw(), $label->cstr());
    }

    /**
     * Xcode GPU capture group on the command buffer. Balance with popDebugGroup.
     */
    public function pushDebugGroup(const string& $label) : void
    {
        cCommandPushDebugGroup($this->raw(), $label->cstr());
    }

    public function popDebugGroup() : void
    {
        cCommandPopDebugGroup($this->raw());
    }

    public function computeCommandEncoder() : ComputeCommandEncoder?
    {
        return ComputeCommandEncoder::adopt(cCommandComputePass($this->raw(), null));
    }

    /**
     * Compute encoder from a descriptor, for timestamp samples around the dispatch.
     */
    public function computeCommandEncoder(const ComputePassDescriptor& $pass) : ComputeCommandEncoder?
    {
        $abi = $pass->abi();
        return ComputeCommandEncoder::adopt(cCommandComputePass($this->raw(), &$abi));
    }
}

public class RenderCommandEncoder
{
    private ptr<mtl_render_encoder> $id;
    private bool $ended;

    private constructor(ptr<mtl_render_encoder> $id)
    {
        $this->id = $id;
        $this->ended = false;
    }

    destructor()
    {
        if (!$this->ended && $this->id != null) {
            cRenderEnd($this->id);
            $this->ended = true;
        }

        if ($this->id != null) {
            cRelease(asObj($this->id));
            $this->id:$ = null;
        }
    }

    internal const function raw() : ptr<mtl_render_encoder>
    {
        if ($this->ended) {
            die('mtl: render encoder used after endEncoding');
        }

        return live($this->id, 'RenderCommandEncoder handle is null');
    }

    internal static function adopt(ptr<mtl_render_encoder> $id) : RenderCommandEncoder?
    {
        if ($id == null) {
            return null;
        }

        return RenderCommandEncoder($id);
    }

    public function endEncoding() : void
    {
        if ($this->ended) {
            return;
        }

        cRenderEnd($this->raw());
        $this->ended = true;
    }

    public function setLabel(const string& $label) : void
    {
        cRenderSetLabel($this->raw(), $label->cstr());
    }

    /**
     * Xcode GPU capture group. Balance with popDebugGroup before endEncoding.
     */
    public function pushDebugGroup(const string& $label) : void
    {
        cRenderPushDebugGroup($this->raw(), $label->cstr());
    }

    public function popDebugGroup() : void
    {
        cRenderPopDebugGroup($this->raw());
    }

    /**
     * Write one timestamp into `$buffer` at `$index`. `barrier: true` is more
     * deterministic and can change GPU time; lightweight profiling uses false.
     */
    public function sampleCounters(CounterSampleBuffer $buffer, uint64 $index, barrier: bool $barrier = false) : void
    {
        int32 $b = 0;

        if ($barrier) {
            $b = 1;
        }

        cRenderSampleCounters($this->raw(), $buffer->raw(), $index, $b);
    }

    public function setRenderPipelineState(RenderPipelineState $pipeline) : void
    {
        cRenderSetPipeline($this->raw(), $pipeline->raw());
    }

    public function setDepthStencilState(DepthStencilState $state) : void
    {
        cRenderSetDepthStencil($this->raw(), $state->raw());
    }

    public function setVertexBuffer(Buffer $buffer, uint32 $offset = 0, index: uint32 $index) : void
    {
        cRenderSetVertexBuffer($this->raw(), $buffer->raw(), $offset as uint64, $index);
    }

    public function setFragmentBuffer(Buffer $buffer, uint32 $offset = 0, index: uint32 $index) : void
    {
        cRenderSetFragmentBuffer($this->raw(), $buffer->raw(), $offset as uint64, $index);
    }

    public function setVertexBytes<T>(const T& $data, index: uint32 $index) : void
    {
        ptr<uint8> $p = &$data;
        cRenderSetVertexBytes($this->raw(), ptr<const uint8>($p:$), mem::size<T>() as uint64, $index);
    }

    public function setFragmentBytes<T>(const T& $data, index: uint32 $index) : void
    {
        ptr<uint8> $p = &$data;
        cRenderSetFragmentBytes($this->raw(), ptr<const uint8>($p:$), mem::size<T>() as uint64, $index);
    }

    public function setFragmentTexture(Texture $texture, index: uint32 $index) : void
    {
        cRenderSetFragmentTexture($this->raw(), $texture->raw(), $index);
    }

    public function setFragmentSamplerState(SamplerState $sampler, index: uint32 $index) : void
    {
        cRenderSetFragmentSampler($this->raw(), $sampler->raw(), $index);
    }

    public function setVertexTexture(Texture $texture, index: uint32 $index) : void
    {
        cRenderSetVertexTexture($this->raw(), $texture->raw(), $index);
    }

    public function setVertexSamplerState(SamplerState $sampler, index: uint32 $index) : void
    {
        cRenderSetVertexSampler($this->raw(), $sampler->raw(), $index);
    }

    public function setTessellationFactorBuffer(Buffer $buffer, uint64 $offset = 0, uint32 $instanceStride = 0) : void
    {
        cRenderSetTessellationFactorBuffer($this->raw(), $buffer->raw(), $offset, $instanceStride);
    }

    public function setViewport(Viewport $viewport) : void
    {
        cRenderSetViewport(
            $this->raw(),
            $viewport->originX,
            $viewport->originY,
            $viewport->width,
            $viewport->height,
            $viewport->znear,
            $viewport->zfar
        );
    }

    public function setScissorRect(ScissorRect $rect) : void
    {
        cRenderSetScissor($this->raw(), $rect->x, $rect->y, $rect->width, $rect->height);
    }

    public function setCullMode(CullMode $mode) : void
    {
        cRenderSetCull($this->raw(), $mode->value());
    }

    public function setFrontFacing(Winding $winding) : void
    {
        cRenderSetWinding($this->raw(), $winding->value());
    }

    public function setTriangleFillMode(TriangleFillMode $mode) : void
    {
        cRenderSetTriangleFill($this->raw(), $mode->value());
    }

    public function drawPrimitives(
        PrimitiveType $type,
        uint32 $vertexStart,
        uint32 $vertexCount,
        uint32 $instanceCount = 1
    ) : void
    {
        cRenderDraw($this->raw(), $type->value(), $vertexStart, $vertexCount, $instanceCount);
    }

    public function drawIndexedPrimitives(
        PrimitiveType $type,
        uint32 $indexCount,
        IndexType $indexType,
        Buffer $indexBuffer,
        uint32 $indexBufferOffset = 0,
        uint32 $instanceCount = 1
    ) : void
    {
        cRenderDrawIndexed(
            $this->raw(),
            $type->value(),
            $indexCount,
            $indexType->value(),
            $indexBuffer->raw(),
            $indexBufferOffset as uint64,
            $instanceCount
        );
    }

    public function drawPatches(
        uint32 $controlPoints,
        uint32 $patchStart,
        uint32 $patchCount,
        uint32 $instanceCount = 1
    ) : void
    {
        cRenderDrawPatches($this->raw(), $controlPoints, $patchStart, $patchCount, $instanceCount);
    }
}

public class BlitCommandEncoder
{
    private ptr<mtl_blit_encoder> $id;
    private bool $ended;

    private constructor(ptr<mtl_blit_encoder> $id)
    {
        $this->id = $id;
        $this->ended = false;
    }

    destructor()
    {
        if (!$this->ended && $this->id != null) {
            cBlitEnd($this->id);
            $this->ended = true;
        }

        if ($this->id != null) {
            cRelease(asObj($this->id));
            $this->id:$ = null;
        }
    }

    internal const function raw() : ptr<mtl_blit_encoder>
    {
        if ($this->ended) {
            die('mtl: blit encoder used after endEncoding');
        }

        return live($this->id, 'BlitCommandEncoder handle is null');
    }

    internal static function adopt(ptr<mtl_blit_encoder> $id) : BlitCommandEncoder?
    {
        if ($id == null) {
            return null;
        }

        return BlitCommandEncoder($id);
    }

    public function endEncoding() : void
    {
        if ($this->ended) {
            return;
        }

        cBlitEnd($this->raw());
        $this->ended = true;
    }

    public function setLabel(const string& $label) : void
    {
        cBlitSetLabel($this->raw(), $label->cstr());
    }

    /**
     * Xcode GPU capture group. Balance with popDebugGroup before endEncoding.
     */
    public function pushDebugGroup(const string& $label) : void
    {
        cBlitPushDebugGroup($this->raw(), $label->cstr());
    }

    public function popDebugGroup() : void
    {
        cBlitPopDebugGroup($this->raw());
    }

    /**
     * Write one timestamp into `$buffer` at `$index`. `barrier: true` can change GPU time.
     */
    public function sampleCounters(CounterSampleBuffer $buffer, uint64 $index, barrier: bool $barrier = false) : void
    {
        int32 $b = 0;

        if ($barrier) {
            $b = 1;
        }

        cBlitSampleCounters($this->raw(), $buffer->raw(), $index, $b);
    }

    public function copyFromBuffer(
        Buffer $source,
        usize $sourceOffset,
        Buffer $destination,
        usize $destinationOffset,
        usize $size
    ) : void
    {
        cBlitCopyBuffer(
            $this->raw(),
            $source->raw(),
            $sourceOffset as uint64,
            $destination->raw(),
            $destinationOffset as uint64,
            $size as uint64
        );
    }

    /** fills every mip below level 0 from the level above it */
    public function generateMipmaps(Texture $texture) : void
    {
        cBlitGenerateMipmaps($this->raw(), $texture->raw());
    }

    public function copyFromTexture(
        Texture $source,
        Origin $sourceOrigin,
        Size $sourceSize,
        Texture $destination,
        Origin $destinationOrigin,
        sourceSlice: uint32 $sourceSlice = 0,
        sourceLevel: uint32 $sourceLevel = 0,
        destinationSlice: uint32 $destinationSlice = 0,
        destinationLevel: uint32 $destinationLevel = 0
    ) : void
    {
        cBlitCopyTexture(
            $this->raw(),
            $source->raw(),
            $sourceSlice,
            $sourceLevel,
            $sourceOrigin->x as uint64,
            $sourceOrigin->y as uint64,
            $sourceOrigin->z as uint64,
            $sourceSize->width as uint64,
            $sourceSize->height as uint64,
            $sourceSize->depth as uint64,
            $destination->raw(),
            $destinationSlice,
            $destinationLevel,
            $destinationOrigin->x as uint64,
            $destinationOrigin->y as uint64,
            $destinationOrigin->z as uint64
        );
    }
}

public class ComputeCommandEncoder
{
    private ptr<mtl_compute_encoder> $id;
    private bool $ended;

    private constructor(ptr<mtl_compute_encoder> $id)
    {
        $this->id = $id;
        $this->ended = false;
    }

    destructor()
    {
        if (!$this->ended && $this->id != null) {
            cComputeEnd($this->id);
            $this->ended = true;
        }

        if ($this->id != null) {
            cRelease(asObj($this->id));
            $this->id:$ = null;
        }
    }

    internal const function raw() : ptr<mtl_compute_encoder>
    {
        if ($this->ended) {
            die('mtl: compute encoder used after endEncoding');
        }

        return live($this->id, 'ComputeCommandEncoder handle is null');
    }

    internal static function adopt(ptr<mtl_compute_encoder> $id) : ComputeCommandEncoder?
    {
        if ($id == null) {
            return null;
        }

        return ComputeCommandEncoder($id);
    }

    public function endEncoding() : void
    {
        if ($this->ended) {
            return;
        }

        cComputeEnd($this->raw());
        $this->ended = true;
    }

    public function setLabel(const string& $label) : void
    {
        cComputeSetLabel($this->raw(), $label->cstr());
    }

    /**
     * Xcode GPU capture group. Balance with popDebugGroup before endEncoding.
     */
    public function pushDebugGroup(const string& $label) : void
    {
        cComputePushDebugGroup($this->raw(), $label->cstr());
    }

    public function popDebugGroup() : void
    {
        cComputePopDebugGroup($this->raw());
    }

    /**
     * Write one timestamp into `$buffer` at `$index`. `barrier: true` can change GPU time.
     */
    public function sampleCounters(CounterSampleBuffer $buffer, uint64 $index, barrier: bool $barrier = false) : void
    {
        int32 $b = 0;

        if ($barrier) {
            $b = 1;
        }

        cComputeSampleCounters($this->raw(), $buffer->raw(), $index, $b);
    }

    public function setComputePipelineState(ComputePipelineState $pipeline) : void
    {
        cComputeSetPipeline($this->raw(), $pipeline->raw());
    }

    public function setBuffer(Buffer $buffer, uint32 $offset = 0, index: uint32 $index) : void
    {
        cComputeSetBuffer($this->raw(), $buffer->raw(), $offset as uint64, $index);
    }

    public function setBytes<T>(const T& $data, index: uint32 $index) : void
    {
        ptr<uint8> $p = &$data;
        cComputeSetBytes($this->raw(), ptr<const uint8>($p:$), mem::size<T>() as uint64, $index);
    }

    public function setTexture(Texture $texture, index: uint32 $index) : void
    {
        cComputeSetTexture($this->raw(), $texture->raw(), $index);
    }

    public function dispatchThreads(Size $threadsPerGrid, Size $threadsPerThreadgroup) : void
    {
        cComputeDispatch(
            $this->raw(),
            $threadsPerGrid->width as uint64,
            $threadsPerGrid->height as uint64,
            $threadsPerGrid->depth as uint64,
            $threadsPerThreadgroup->width as uint64,
            $threadsPerThreadgroup->height as uint64,
            $threadsPerThreadgroup->depth as uint64
        );
    }
}
