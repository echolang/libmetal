/**
 * `id<MTLDevice>`. The GPU. Parameterless statics, because there is
 * nothing to label: `systemDefault` and `all`.
 */

namespace mtl;

#[atomic]
public class Device
{
    private ptr<mtl_device> $id;

    private constructor(ptr<mtl_device> $id)
    {
        $this->id = $id;
    }

    destructor()
    {
        if ($this->id != null) {
            cRelease(asObj($this->id));
            $this->id:$ = null;
        }
    }

    internal const function raw() : ptr<mtl_device>
    {
        return live($this->id, 'Device handle is null');
    }

    internal static function adopt(ptr<mtl_device> $id) : Device?
    {
        if ($id == null) {
            return null;
        }

        return Device($id);
    }

    public static function systemDefault() : Device?
    {
        return Device::adopt(cDeviceDefault());
    }

    public static function all() : array<Device>
    {
        array<Device> $out = array<Device>();
        uint64 $n = cDeviceCount();
        uint64 $i = 0;

        while ($i < $n) {
            Device $d = guard Device::adopt(cDeviceAt($i)) else {
                $i = $i + 1;
                continue;
            }
            $out[] = $d;
            $i = $i + 1;
        }

        return $out;
    }

    public const function name() : string
    {
        string $buf = '';
        ptr<uint8> $p = errSpare($buf);
        cDeviceName($this->raw(), $p, ERR_CAP);
        return takeCString($p);
    }

    public function newCommandQueue(string? $label = null) : CommandQueue?
    {
        string $text = guard $label else {
            return CommandQueue::adopt(cDeviceNewQueue($this->raw(), null));
        }

        return CommandQueue::adopt(cDeviceNewQueue($this->raw(), $text->cstr()));
    }

    public function newBuffer(usize $length, ResourceOptions $options = .shared) : Buffer?
    {
        return Buffer::adopt(cDeviceNewBuffer($this->raw(), $length as uint64, $options->value()));
    }

    public function newBuffer(
        bytes: ptr<uint8> $bytes,
        usize $length,
        ResourceOptions $options = .shared
    ) : Buffer?
    {
        return Buffer::adopt(
            cDeviceNewBufferBytes($this->raw(), ptr<const uint8>($bytes:$), $length as uint64, $options->value())
        );
    }

    public function newTexture(const TextureDescriptor& $desc) : Texture?
    {
        $abi = $desc->abi();
        return Texture::adopt(cDeviceNewTexture($this->raw(), &$abi));
    }

    public function newSamplerState(const SamplerDescriptor& $desc) : SamplerState?
    {
        $abi = $desc->abi();
        return SamplerState::adopt(cDeviceNewSampler($this->raw(), &$abi));
    }

    public function newLibrary(source: const string& $msl) : result<Library, Error>
    {
        return $this->newLibrary(source: $msl, CompileOptions(true, .default));
    }

    public function newLibrary(source: const string& $msl, CompileOptions $options) : result<Library, Error>
    {
        $opts = $options->abi();
        string $err = '';
        ptr<uint8> $ep = errSpare($err);
        ptr<mtl_library> $p = cDeviceNewLibrarySource($this->raw(), $msl->cstr(), &$opts, $ep, ERR_CAP);

        if ($p == null) {
            return .error(Error::compile(takeCString($ep)));
        }

        Library $lib = guard Library::adopt($p) else {
            return .error(Error::compile('library pointer was null'));
        }
        return .ok($lib);
    }

    public function newLibrary(data: ptr<uint8> $bytes, usize $length) : result<Library, Error>
    {
        string $err = '';
        ptr<uint8> $ep = errSpare($err);
        ptr<mtl_library> $p = cDeviceNewLibraryData(
            $this->raw(),
            ptr<const uint8>($bytes:$),
            $length as uint64,
            $ep,
            ERR_CAP
        );

        if ($p == null) {
            return .error(Error::compile(takeCString($ep)));
        }

        Library $lib = guard Library::adopt($p) else {
            return .error(Error::compile('library pointer was null'));
        }
        return .ok($lib);
    }

    public function newRenderPipelineState(const RenderPipelineDescriptor& $desc) : result<RenderPipelineState, Error>
    {
        $abi = $desc->abi();
        string $err = '';
        ptr<uint8> $ep = errSpare($err);
        ptr<mtl_render_pipeline> $p = cDeviceNewRenderPipeline($this->raw(), &$abi, $ep, ERR_CAP);

        if ($p == null) {
            return .error(Error::pipeline(takeCString($ep)));
        }

        RenderPipelineState $ps = guard RenderPipelineState::adopt($p) else {
            return .error(Error::pipeline('pipeline pointer was null'));
        }
        return .ok($ps);
    }

    public function newComputePipelineState(Function $function) : result<ComputePipelineState, Error>
    {
        string $err = '';
        ptr<uint8> $ep = errSpare($err);
        ptr<mtl_compute_pipeline> $p = cDeviceNewComputePipeline($this->raw(), $function->raw(), $ep, ERR_CAP);

        if ($p == null) {
            return .error(Error::pipeline(takeCString($ep)));
        }

        ComputePipelineState $ps = guard ComputePipelineState::adopt($p) else {
            return .error(Error::pipeline('pipeline pointer was null'));
        }
        return .ok($ps);
    }

    public function newDepthStencilState(const DepthStencilDescriptor& $desc) : DepthStencilState?
    {
        $abi = $desc->abi();
        return DepthStencilState::adopt(cDeviceNewDepthStencil($this->raw(), &$abi));
    }
}
