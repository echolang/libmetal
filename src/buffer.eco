/**
 * `id<MTLBuffer>`.
 */

namespace mtl;

#[atomic]
public class Buffer
{
    private ptr<mtl_buffer> $id;

    private constructor(ptr<mtl_buffer> $id)
    {
        $this->id = $id;
    }

    destructor()
    {
        if ($this->id != null) {
            cRelease(asObj($this->id));
            $this->id:$ = null;
        }
    }

    internal const function raw() : ptr<mtl_buffer>
    {
        return live($this->id, 'Buffer handle is null');
    }

    internal static function adopt(ptr<mtl_buffer> $id) : Buffer?
    {
        if ($id == null) {
            return null;
        }

        return Buffer($id);
    }

    public const function length() : usize
    {
        return cBufferLength($this->raw()) as usize;
    }

    /**
     * CPU pointer. Null for `private` storage.
     */
    public function contents() : ptr<uint8>
    {
        return cBufferContents($this->raw());
    }
}
