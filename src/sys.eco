/**
 * Every C symbol this module is built out of, in one place.
 *
 * A C symbol may only be declared once per module. internal: other files
 * in this module call these, a consumer does not.
 */

namespace mtl;

internal extern {
    struct mtl_device;
    struct mtl_queue;
    struct mtl_buffer;
    struct mtl_texture;
    struct mtl_sampler;
    struct mtl_library;
    struct mtl_function;
    struct mtl_render_pipeline;
    struct mtl_compute_pipeline;
    struct mtl_depth_stencil;
    struct mtl_command_buffer;
