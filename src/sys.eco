/**
 * Every C symbol this module is built out of, in one place.
 *
 * A C symbol may only be declared once per module. internal: other files
 * in this module call these, a consumer does not.
 */

namespace mtl;

internal extern {
    function mtl_retain as cRetain(ptr<uint8> $obj) : void;
    function mtl_release as cRelease(ptr<uint8> $obj) : void;

    function mtl_device_default as cDeviceDefault() : ptr<uint8>;
    function mtl_device_count as cDeviceCount() : uint64;
    function mtl_device_at as cDeviceAt(uint64 $i) : ptr<uint8>;
    function mtl_device_name as cDeviceName(ptr<uint8> $device, ptr<uint8> $buf, usize $cap) : void;
    function mtl_device_new_queue as cDeviceNewQueue(ptr<uint8> $device, ptr<const uint8> $label) : ptr<uint8>;
    function mtl_device_new_buffer as cDeviceNewBuffer(ptr<uint8> $device, uint64 $length, uint32 $options) : ptr<uint8>;
    function mtl_device_new_buffer_bytes as cDeviceNewBufferBytes(
        ptr<uint8> $device,
        ptr<const uint8> $bytes,
        uint64 $length,
        uint32 $options
    ) : ptr<uint8>;
    function mtl_device_new_texture as cDeviceNewTexture(ptr<uint8> $device, ptr<const AbiTextureDesc> $desc) : ptr<uint8>;
    function mtl_device_new_sampler as cDeviceNewSampler(ptr<uint8> $device, ptr<const AbiSamplerDesc> $desc) : ptr<uint8>;
    function mtl_device_new_library_source as cDeviceNewLibrarySource(
        ptr<uint8> $device,
        ptr<const uint8> $source,
        ptr<const AbiCompileOpts> $opts,
        ptr<uint8> $err,
        usize $errCap
    ) : ptr<uint8>;
    function mtl_device_new_library_data as cDeviceNewLibraryData(
        ptr<uint8> $device,
        ptr<const uint8> $bytes,
        uint64 $length,
        ptr<uint8> $err,
        usize $errCap
    ) : ptr<uint8>;
    function mtl_device_new_render_pipeline as cDeviceNewRenderPipeline(
        ptr<uint8> $device,
        ptr<const AbiRenderPipeline> $desc,
        ptr<uint8> $err,
        usize $errCap
    ) : ptr<uint8>;
    function mtl_device_new_compute_pipeline as cDeviceNewComputePipeline(
        ptr<uint8> $device,
        ptr<uint8> $function,
        ptr<uint8> $err,
        usize $errCap
    ) : ptr<uint8>;
    function mtl_device_new_depth_stencil as cDeviceNewDepthStencil(
        ptr<uint8> $device,
        ptr<const AbiDepthStencil> $desc
    ) : ptr<uint8>;

    function mtl_buffer_length as cBufferLength(ptr<uint8> $buffer) : uint64;
    function mtl_buffer_contents as cBufferContents(ptr<uint8> $buffer) : ptr<uint8>;
    function mtl_texture_replace as cTextureReplace(
        ptr<uint8> $texture,
        uint64 $ox,
        uint64 $oy,
        uint64 $oz,
        uint64 $width,
        uint64 $height,
        uint64 $depth,
        uint32 $mip,
        ptr<const uint8> $bytes,
        uint64 $bytesPerRow
    ) : void;
    function mtl_texture_width as cTextureWidth(ptr<uint8> $texture) : uint64;
    function mtl_texture_height as cTextureHeight(ptr<uint8> $texture) : uint64;

    function mtl_library_new_function as cLibraryNewFunction(ptr<uint8> $library, ptr<const uint8> $name) : ptr<uint8>;

    function mtl_queue_command_buffer as cQueueCommandBuffer(ptr<uint8> $queue) : ptr<uint8>;
    function mtl_command_commit as cCommandCommit(ptr<uint8> $cmd) : void;
    function mtl_command_wait as cCommandWait(ptr<uint8> $cmd) : void;
    function mtl_command_present as cCommandPresent(ptr<uint8> $cmd, ptr<uint8> $drawable) : void;
    function mtl_command_render as cCommandRender(ptr<uint8> $cmd, ptr<const AbiRenderPass> $pass) : ptr<uint8>;
    function mtl_command_blit as cCommandBlit(ptr<uint8> $cmd) : ptr<uint8>;
    function mtl_command_compute as cCommandCompute(ptr<uint8> $cmd) : ptr<uint8>;

    function mtl_render_end as cRenderEnd(ptr<uint8> $enc) : void;
    function mtl_render_set_pipeline as cRenderSetPipeline(ptr<uint8> $enc, ptr<uint8> $pipeline) : void;
    function mtl_render_set_depth_stencil as cRenderSetDepthStencil(ptr<uint8> $enc, ptr<uint8> $state) : void;
    function mtl_render_set_vertex_buffer as cRenderSetVertexBuffer(
        ptr<uint8> $enc,
        ptr<uint8> $buffer,
        uint64 $offset,
        uint32 $index
    ) : void;
    function mtl_render_set_fragment_buffer as cRenderSetFragmentBuffer(
        ptr<uint8> $enc,
        ptr<uint8> $buffer,
        uint64 $offset,
        uint32 $index
    ) : void;
    function mtl_render_set_vertex_bytes as cRenderSetVertexBytes(
        ptr<uint8> $enc,
        ptr<const uint8> $bytes,
        uint64 $length,
        uint32 $index
    ) : void;
    function mtl_render_set_fragment_bytes as cRenderSetFragmentBytes(
        ptr<uint8> $enc,
        ptr<const uint8> $bytes,
        uint64 $length,
        uint32 $index
    ) : void;
    function mtl_render_set_fragment_texture as cRenderSetFragmentTexture(
        ptr<uint8> $enc,
        ptr<uint8> $texture,
        uint32 $index
    ) : void;
    function mtl_render_set_fragment_sampler as cRenderSetFragmentSampler(
        ptr<uint8> $enc,
        ptr<uint8> $sampler,
        uint32 $index
    ) : void;
    function mtl_render_set_viewport as cRenderSetViewport(
        ptr<uint8> $enc,
        float64 $originX,
        float64 $originY,
        float64 $width,
        float64 $height,
        float64 $znear,
        float64 $zfar
    ) : void;
    function mtl_render_set_scissor as cRenderSetScissor(
        ptr<uint8> $enc,
        uint32 $x,
        uint32 $y,
        uint32 $width,
        uint32 $height
    ) : void;
    function mtl_render_set_cull as cRenderSetCull(ptr<uint8> $enc, uint32 $mode) : void;
    function mtl_render_set_winding as cRenderSetWinding(ptr<uint8> $enc, uint32 $winding) : void;
    function mtl_render_draw as cRenderDraw(
        ptr<uint8> $enc,
        uint32 $primitive,
        uint32 $start,
        uint32 $count,
        uint32 $instances
    ) : void;
    function mtl_render_draw_indexed as cRenderDrawIndexed(
        ptr<uint8> $enc,
        uint32 $primitive,
        uint32 $indexCount,
        uint32 $indexType,
        ptr<uint8> $indexBuffer,
        uint64 $indexOffset,
        uint32 $instances
    ) : void;

    function mtl_blit_end as cBlitEnd(ptr<uint8> $enc) : void;
    function mtl_blit_copy_buffer as cBlitCopyBuffer(
        ptr<uint8> $enc,
        ptr<uint8> $src,
        uint64 $srcOffset,
        ptr<uint8> $dst,
        uint64 $dstOffset,
        uint64 $size
    ) : void;

    function mtl_compute_end as cComputeEnd(ptr<uint8> $enc) : void;
    function mtl_compute_set_pipeline as cComputeSetPipeline(ptr<uint8> $enc, ptr<uint8> $pipeline) : void;
    function mtl_compute_set_buffer as cComputeSetBuffer(
        ptr<uint8> $enc,
        ptr<uint8> $buffer,
        uint64 $offset,
        uint32 $index
    ) : void;
    function mtl_compute_set_bytes as cComputeSetBytes(
        ptr<uint8> $enc,
        ptr<const uint8> $bytes,
        uint64 $length,
        uint32 $index
    ) : void;
    function mtl_compute_set_texture as cComputeSetTexture(ptr<uint8> $enc, ptr<uint8> $texture, uint32 $index) : void;
    function mtl_compute_dispatch as cComputeDispatch(
        ptr<uint8> $enc,
        uint64 $tw,
        uint64 $th,
        uint64 $td,
        uint64 $gw,
        uint64 $gh,
        uint64 $gd
    ) : void;

    function mtl_layer_create as cLayerCreate(
        ptr<uint8> $device,
        uint64 $width,
        uint64 $height,
        uint32 $pixelFormat
    ) : ptr<uint8>;
    function mtl_layer_from_ptr as cLayerFromPtr(ptr<uint8> $layer) : ptr<uint8>;
    function mtl_layer_attach_view as cLayerAttachView(
        ptr<uint8> $device,
        ptr<uint8> $view,
        uint32 $pixelFormat
    ) : ptr<uint8>;
    function mtl_layer_set_device as cLayerSetDevice(ptr<uint8> $layer, ptr<uint8> $device) : void;
    function mtl_layer_set_pixel_format as cLayerSetPixelFormat(ptr<uint8> $layer, uint32 $format) : void;
    function mtl_layer_set_drawable_size as cLayerSetDrawableSize(
        ptr<uint8> $layer,
        uint64 $width,
        uint64 $height
    ) : void;
    function mtl_layer_get_drawable_size as cLayerGetDrawableSize(
        ptr<uint8> $layer,
        ptr<uint64> $width,
        ptr<uint64> $height
    ) : void;
    function mtl_layer_set_contents_scale as cLayerSetContentsScale(ptr<uint8> $layer, float64 $scale) : void;
    function mtl_layer_contents_scale as cLayerContentsScale(ptr<uint8> $layer) : float64;
    function mtl_layer_set_framebuffer_only as cLayerSetFramebufferOnly(ptr<uint8> $layer, int32 $only) : void;
    function mtl_layer_next_drawable as cLayerNextDrawable(ptr<uint8> $layer) : ptr<uint8>;
    function mtl_drawable_texture as cDrawableTexture(ptr<uint8> $drawable) : ptr<uint8>;
}
