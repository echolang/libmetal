    struct mtl_blit_encoder;
    struct mtl_compute_encoder;
    struct mtl_layer;
    struct mtl_drawable;
    struct mtl_shared_event;
    struct mtl_counter_sample_buffer;

    function mtl_retain as cRetain(ptr<uint8> $obj) : void;
    function mtl_release as cRelease(ptr<uint8> $obj) : void;

    function mtl_device_default as cDeviceDefault() : ptr<mtl_device>;
    function mtl_device_count as cDeviceCount() : uint64;
    function mtl_device_at as cDeviceAt(uint64 $i) : ptr<mtl_device>;
    function mtl_device_name as cDeviceName(ptr<mtl_device> $device, ptr<uint8> $buf, usize $cap) : void;
