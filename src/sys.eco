    function mtl_device_new_sampler as cDeviceNewSampler(ptr<mtl_device> $device, ptr<const AbiSamplerDesc> $desc) : ptr<mtl_sampler>;
    function mtl_device_new_library_source as cDeviceNewLibrarySource(
