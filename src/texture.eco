/**
 * `id<MTLTexture>` and the descriptor you build it from.
 */

namespace mtl;

public struct TextureDescriptor
{
    public TextureType $textureType = .type2D;
    public PixelFormat $pixelFormat;
    public usize $width;
    public usize $height = 1;
    public usize $depth = 1;
    public usize $mipmapLevelCount = 1;
    public usize $sampleCount = 1;
    public usize $arrayLength = 1;
    public uint32 $usage = TEXTURE_USAGE_SHADER_READ;
    public StorageMode $storageMode = .devicePrivate;

    internal const function abi() : AbiTextureDesc
    {
        return AbiTextureDesc(
            $this->textureType->value(),
            $this->pixelFormat->value(),
            $this->width as uint64,
            $this->height as uint64,
            $this->depth as uint64,
            $this->mipmapLevelCount as uint64,
            $this->sampleCount as uint64,
            $this->arrayLength as uint64,
            $this->usage,
            $this->storageMode->value()
        );
    }
}

#[atomic]
public class Texture
{
    private ptr<mtl_texture> $id;

    private constructor(ptr<mtl_texture> $id)
    {
        $this->id = $id;
    }

    destructor()
    {
        if ($this->id != null) {
            cRelease(asObj($this->id));
            $this->id:$ = null;
        }
    }

    internal const function raw() : ptr<mtl_texture>
    {
        return live($this->id, 'Texture handle is null');
    }

    internal static function adopt(ptr<mtl_texture> $id) : Texture?
    {
        if ($id == null) {
            return null;
        }

        return Texture($id);
    }

    public const function width() : usize
    {
        return cTextureWidth($this->raw()) as usize;
    }

    public const function height() : usize
    {
        return cTextureHeight($this->raw()) as usize;
    }

    public function replace(Region $region, ptr<uint8> $bytes, usize $bytesPerRow, uint32 $mipmapLevel = 0) : void
    {
        cTextureReplace(
            $this->raw(),
            $region->origin->x as uint64,
            $region->origin->y as uint64,
            $region->origin->z as uint64,
            $region->size->width as uint64,
            $region->size->height as uint64,
            $region->size->depth as uint64,
            $mipmapLevel,
            0,
            ptr<const uint8>($bytes:$),
            $bytesPerRow as uint64,
            0
        );
    }

    /**
     * Writes one array slice. A cube face is a slice, in the order
     * +X -X +Y -Y +Z -Z. `bytesPerImage` is the stride between images;
     * tightly packed is `bytesPerRow * height`.
     */
    public function replace(
        Region $region,
        ptr<uint8> $bytes,
        usize $bytesPerRow,
        uint32 $mipmapLevel,
        slice: uint32 $slice,
        bytesPerImage: usize $bytesPerImage
    ) : void
    {
        cTextureReplace(
            $this->raw(),
            $region->origin->x as uint64,
            $region->origin->y as uint64,
            $region->origin->z as uint64,
            $region->size->width as uint64,
            $region->size->height as uint64,
            $region->size->depth as uint64,
            $mipmapLevel,
            $slice,
            ptr<const uint8>($bytes:$),
            $bytesPerRow as uint64,
            $bytesPerImage as uint64
        );
    }

    public function getBytes(ptr<uint8> $bytes, usize $bytesPerRow, Region $region, uint32 $mipmapLevel = 0) : void
    {
        cTextureGetBytes(
            $this->raw(),
            $bytes,
            $bytesPerRow as uint64,
            0,
            $region->origin->x as uint64,
            $region->origin->y as uint64,
            $region->origin->z as uint64,
            $region->size->width as uint64,
            $region->size->height as uint64,
            $region->size->depth as uint64,
            $mipmapLevel,
            0
        );
    }

    public function getBytes(
        ptr<uint8> $bytes,
        usize $bytesPerRow,
        Region $region,
        uint32 $mipmapLevel,
        slice: uint32 $slice,
        bytesPerImage: usize $bytesPerImage
    ) : void
    {
        cTextureGetBytes(
            $this->raw(),
            $bytes,
            $bytesPerRow as uint64,
            $bytesPerImage as uint64,
            $region->origin->x as uint64,
            $region->origin->y as uint64,
            $region->origin->z as uint64,
            $region->size->width as uint64,
            $region->size->height as uint64,
            $region->size->depth as uint64,
            $mipmapLevel,
            $slice
        );
    }
}
