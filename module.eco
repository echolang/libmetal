/*
 * libmetal - Metal GPU bindings for Echo.
 *
 * A C ABI shim in Objective-C, Echo classes on top. Apple platforms only:
 * macOS, iOS, tvOS. No AppKit, no UIKit. A consumer adds it with epm and
 * nothing else.
 */

#[module: "libmetal"]
#[version: "0.1.2"] // x-release-please-version
#[epm::license: "MIT"]
#[epm::description: "Metal GPU bindings for Echo"]

#[if: os == darwin || os == ios]
#[sources: "src/*.eco"]
#[cc: sources "c/*.m"]
#[cc: flag "-fobjc-arc"]
#[link: framework "Metal"]
#[link: framework "QuartzCore"]
#[link: framework "Foundation"]
#[else]
#[sources: "unsupported.eco"]
#[end]

#[target: test] {
    #[sources: "tests/*.eco"]
}
