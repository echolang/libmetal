/**
 * GPU-free backing values. Apple's numbers, not ours.
 */

#[if: os == darwin || os == ios]
test pixel_formats
{
    assert(mtl::PixelFormat::bgra8Unorm->value() == 80);
    assert(mtl::PixelFormat::rgba8Unorm->value() == 70);
    assert(mtl::PixelFormat::depth32Float->value() == 252);
    assert(mtl::PixelFormat::depth32Float_stencil8->value() == 260);
    assert(mtl::PixelFormat::astc4x4Srgb->value() == 186);
    assert(mtl::PixelFormat::astc4x4Ldr->value() == 204);
    assert(mtl::PixelFormat::bc1Rgba->value() == 130);
    assert(mtl::PixelFormat::bc7RgbaUnorm->value() == 152);
    assert(mtl::PixelFormat::bc7RgbaUnorm_srgb->value() == 153);
}

test storage_and_resource_options
{
    assert(mtl::StorageMode::shared->value() == 0);
    assert(mtl::StorageMode::managed->value() == 1);
    assert(mtl::StorageMode::devicePrivate->value() == 2);
    assert(mtl::StorageMode::memoryless->value() == 3);
    assert(mtl::ResourceOptions::shared->value() == 0);
    assert(mtl::ResourceOptions::managed->value() == 16);
    assert(mtl::ResourceOptions::devicePrivate->value() == 32);
    assert(mtl::ResourceOptions::memoryless->value() == 48);
}

test primitive_and_load
{
    assert(mtl::PrimitiveType::triangle->value() == 3);
    assert(mtl::TriangleFillMode::fill->value() == 0);
    assert(mtl::TriangleFillMode::lines->value() == 1);
    assert(mtl::LoadAction::clear->value() == 2);
    assert(mtl::StoreAction::store->value() == 1);
    assert(mtl::IndexType::uint16->value() == 0);
    assert(mtl::IndexType::uint32->value() == 1);
    assert(mtl::VertexStepFunction::perPatch->value() == 3);
    assert(mtl::VertexStepFunction::perPatchControlPoint->value() == 4);
    assert(mtl::TessellationPartitionMode::pow2->value() == 0);
    assert(mtl::TessellationFactorStepFunction::constant->value() == 0);
    assert(mtl::TessellationFactorStepFunction::perInstance->value() == 2);
    assert(mtl::Winding::clockwise->value() == 0);
}

test language_version
{
    assert(mtl::LanguageVersion::v2_4->value() == 131076);
    assert(mtl::LanguageVersion::v3_0->value() == 196608);
    assert(mtl::LanguageVersion::default->value() == 0);
}

test texture_usage_bits
{
    assert(mtl::TEXTURE_USAGE_SHADER_READ == 1);
    assert(mtl::TEXTURE_USAGE_RENDER_TARGET == 4);
}

test error_message
{
    $e = mtl::Error::compile('bad msl');
    assert($e->message() == 'bad msl');
    assert("{$e}" == 'bad msl');
}

test counter_sampling_and_status
{
    assert(mtl::CounterSamplingPoint::atStageBoundary->value() == 0);
    assert(mtl::CounterSamplingPoint::atDrawBoundary->value() == 1);
    assert(mtl::CounterSamplingPoint::atBlitBoundary->value() == 4);
    assert(mtl::CommandBufferStatus::notEnqueued->value() == 0);
    assert(mtl::CommandBufferStatus::completed->value() == 4);
    assert(mtl::CommandBufferStatus::error->value() == 5);
    assert(mtl::CommandBufferStatus::from(4) != null);
    assert(mtl::CommandBufferStatus::from(9) == null);
    assert(mtl::COUNTER_DONT_SAMPLE == mtl::cCounterDontSample());
}
#[end]
